# Server Configuration
PORT=3000

# Database Configuration
# Get this from MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.example.mongodb.net/skillsync

# Authentication
# Generate a strong secret key for JSON Web Tokens
JWT_SECRET=your_super_secret_jwt_key_here

# AI Service (Google Gemini)
# Get your API key from Google AI Studio
GOOGLE_API_KEY=AIzaSyYourGeminiApiKeyGoesHere12345
